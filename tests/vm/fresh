#!/usr/bin/env bash
# Boot a blank test VM (a throwaway copy of the clean install), unlock its disk
# and wait until ssh answers. The clean install itself is never changed.
#
#   tests/vm/fresh            VM=2 tests/vm/fresh for a second instance
#
# It will not replace a VM that is already running: that may be someone's
# session. Stop it first with: tests/vm/stop
set -euo pipefail
source "$(dirname "$0")/lib.sh"
need_password
if running; then
  echo "VM $N is already running. Stop it with: VM=$N tests/vm/stop" >&2
  exit 1
fi
setsid "$HERE/run" test >"$VM_DIR/qemu$SFX.log" 2>&1 </dev/null &
for _ in $(seq 30); do running && break; sleep 1; done
running || { echo "QEMU did not start: see $VM_DIR/qemu$SFX.log" >&2; exit 1; }
sleep 20 # firmware and bootloader, up to the disk password
qmp type "$VM_PASSWORD\n"
for _ in $(seq 60); do vm true 2>/dev/null && { echo "VM $N is up (ssh port $PORT)"; exit 0; }; sleep 3; done
echo "VM $N did not answer on ssh" >&2
exit 1
